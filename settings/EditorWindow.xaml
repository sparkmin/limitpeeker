<Window x:Class="LimitPeeker.Settings.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:LimitPeeker.Settings"
        Title="{l:T editor.window.title}"
        Width="1280" Height="800" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <!-- The custom box editor, a window of its own: the presets at the left,
         the box and its tools in the middle, its blocks at the right. -->
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A drawn icon, in the color its button's text has now. -->
        <Style x:Key="Drawn" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Fill" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        </Style>
        <!-- A tool: an icon on a button without a frame until pointed at, faint when it cannot be used. -->
        <Style x:Key="Tool" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The name under a group of tools, as on a ribbon. -->
        <Style x:Key="GroupName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="10,4" />
            <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <!-- A note under the stage, gone while it says nothing. -->
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A heading over a few of a block's properties. -->
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- A property: its name at the left, its value filling the rest. -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Width" Value="84" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A color to pick. -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#33FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The edge between two panes, dragged to size them: a faint line when pointed at. -->
        <Style x:Key="Splitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Rectangle x:Name="Line" Width="2" Opacity="0" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A style a new preset may be made in, as a card to pick. -->
        <!-- A shelf's head in the presets: a chevron, its name and how many it holds; it folds the shelf. -->
        <Style x:Key="ShelfHead" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" CornerRadius="4" Padding="6,4" Margin="0,10,0,2" Background="Transparent">
                            <DockPanel>
                                <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Style="{StaticResource Glyph}" FontSize="10"
                                           Text="&#xE76C;" Margin="0,0,8,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="Shown" />
        <!-- A shelf: its head over the presets on it, folded away when it is closed. An Expander, so that the shelf's
             group tells screen readers it folds. -->
        <Style x:Key="Shelf" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource ShelfHead}" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ContentPresenter Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Shown}}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StyleCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" CornerRadius="8" BorderThickness="1" Padding="12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Frame" Property="Padding" Value="11" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The presets, the box and the blocks, the edges between them dragged to size them. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" MinWidth="190" MaxWidth="440" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="316" MinWidth="280" MaxWidth="520" />
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Style="{StaticResource Splitter}" ToolTip="{l:T editor.presets.splitter}" />
        <GridSplitter Grid.Column="3" Style="{StaticResource Splitter}" ToolTip="{l:T editor.blocks.splitter}" />

        <!-- The presets: the samples, then the user's own. -->
        <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <TextBlock DockPanel.Dock="Top" Text="{l:T editor.presets.title}" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,12" />
                <Button x:Name="CreateButton" DockPanel.Dock="Top" Style="{DynamicResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Click="CreateClicked" ToolTip="Ctrl+N"
                        AutomationProperties.Name="{l:T editor.presets.create}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" />
                        <TextBlock Text="{l:T editor.presets.create}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <!-- Less room inside the two buttons than the theme's, for the longer
                     words of some languages; the buttons stay as wide. -->
                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DuplicateButton" HorizontalAlignment="Stretch" Padding="6,5,6,6" Click="DuplicateBox"
                            ToolTip="{l:T editor.presets.duplicate.tip}" AutomationProperties.Name="{l:T editor.presets.duplicate}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="12" />
                            <TextBlock Text="{l:T editor.presets.duplicate}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Grid.Column="1" HorizontalAlignment="Stretch" Margin="6,0,0,0" Padding="6,5,6,6" Click="DeleteBox"
                            ToolTip="{l:T editor.presets.delete.tip}" AutomationProperties.Name="{l:T editor.presets.delete.field}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="12" />
                            <TextBlock Text="{l:T editor.presets.delete}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- No scrolling across: a long row ends in an ellipsis. -->
                <ListBox x:Name="PresetList" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="PresetPicked" AutomationProperties.Name="{l:T editor.presets.title}">
                    <!-- Each shelf folds under its head; which are folded is kept. -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander Style="{StaticResource Shelf}" IsExpanded="True" Loaded="ShelfLoaded"
                                                          Expanded="ShelfToggled" Collapsed="ShelfToggled"
                                                          AutomationProperties.Name="{Binding Name.Spoken}">
                                                    <Expander.Header>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="12" />
                                                            <TextBlock Text="{Binding Name.Title}" FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="12"
                                           Margin="6,0,0,0" Visibility="{Binding LockShown}" ToolTip="{l:T editor.presets.sample.tip}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding UseShown}" ToolTip="{l:T editor.presets.in_use.tip}"
                                         Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="6" Margin="0,0,10,0"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Path Data="{Binding Icon}" Width="20" Height="20" Stretch="None"
                                          Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- The box: its name and style, the tools, the stage and its size. -->
        <Grid Grid.Column="2" Margin="14,16,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="InUseBadge" CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="{l:T editor.box.in_use.tip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="12"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{l:T editor.box.in_use}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="UseButton" Content="{l:T editor.box.use}" Click="UseClicked" Margin="8,0,0,0"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="SaveButton" Style="{DynamicResource AccentButtonStyle}" Click="SaveBox" Margin="8,0,0,0"
                            MinWidth="96" ToolTip="{l:T editor.box.save.tip}" AutomationProperties.Name="{l:T editor.box.save}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="12" />
                            <TextBlock Text="{l:T editor.box.save}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="BoxName" FontSize="20" FontWeight="SemiBold" MinWidth="220" MaxWidth="340" MaxLength="40"
                             VerticalContentAlignment="Center" ToolTip="{l:T editor.box.name.tip}" TextChanged="BoxEdited"
                             AutomationProperties.Name="{l:T editor.box.name}" />
                    <Border x:Name="SampleBadge" CornerRadius="4" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="{l:T editor.box.sample.tip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="12" />
                            <TextBlock Text="{l:T editor.box.sample}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- The tools in groups, each named under it. Arranging is for a free box. -->
            <Border Grid.Row="1" Margin="0,12,0,0" Padding="8,6,8,4" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <WrapPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UndoButton" Style="{StaticResource Tool}" Click="UndoClicked"
                                    ToolTip="{l:T editor.toolbar.undo.tip}" AutomationProperties.Name="{l:T editor.toolbar.undo}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                            </Button>
                            <Button x:Name="RedoButton" Style="{StaticResource Tool}" Click="RedoClicked"
                                    ToolTip="{l:T editor.toolbar.redo.tip}" AutomationProperties.Name="{l:T editor.toolbar.redo}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{l:T editor.toolbar.history}" Style="{StaticResource GroupName}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource Divider}" />
                    <StackPanel x:Name="ArrangeTools" Orientation="Horizontal" ToolTipService.ShowOnDisabled="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Tool}" Tag="left" Click="AlignClicked" AutomationProperties.Name="{l:T editor.toolbar.align_left}"
                                        ToolTip="{l:T editor.toolbar.align_left.tip}">
                                    <Path Style="{StaticResource Drawn}" Data="M1.5,1 h1.2 v14 h-1.2 Z M4.5,3 h9.5 v3.5 h-9.5 Z M4.5,9.5 h6 v3.5 h-6 Z" />
                                </Button>
                                <Button Style="{StaticResource Tool}" Tag="center" Click="AlignClicked" AutomationProperties.Name="{l:T editor.toolbar.align_center}"
                                        ToolTip="{l:T editor.toolbar.align_center.tip}">
                                    <Path Style="{StaticResource Drawn}" Data="M7.4,1 h1.2 v1.5 h-1.2 Z M7.4,7 h1.2 v2 h-1.2 Z M7.4,13.5 h1.2 v1.5 h-1.2 Z M3,3 h10 v3.5 h-10 Z M5,9.5 h6 v3.5 h-6 Z" />
                                </Button>
                                <Button Style="{StaticResource Tool}" Tag="right" Click="AlignClicked" AutomationProperties.Name="{l:T editor.toolbar.align_right}"
                                        ToolTip="{l:T editor.toolbar.align_right.tip}">
                                    <Path Style="{StaticResource Drawn}" Data="M13.3,1 h1.2 v14 h-1.2 Z M2,3 h9.5 v3.5 h-9.5 Z M5.5,9.5 h6 v3.5 h-6 Z" />
                                </Button>
                                <Button Style="{StaticResource Tool}" Tag="top" Click="AlignClicked" AutomationProperties.Name="{l:T editor.toolbar.align_top}"
                                        ToolTip="{l:T editor.toolbar.align_top.tip}" Margin="6,0,1,0">
                                    <Path Style="{StaticResource Drawn}" Data="M1,1.5 h14 v1.2 h-14 Z M3,4.5 h3.5 v9.5 h-3.5 Z M9.5,4.5 h3.5 v6 h-3.5 Z" />
                                </Button>
                                <Button Style="{StaticResource Tool}" Tag="middle" Click="AlignClicked" AutomationProperties.Name="{l:T editor.toolbar.align_middle}"
                                        ToolTip="{l:T editor.toolbar.align_middle.tip}">
                                    <Path Style="{StaticResource Drawn}" Data="M1,7.4 h1.5 v1.2 h-1.5 Z M7,7.4 h2 v1.2 h-2 Z M13.5,7.4 h1.5 v1.2 h-1.5 Z M3,3 h3.5 v10 h-3.5 Z M9.5,5 h3.5 v6 h-3.5 Z" />
                                </Button>
                                <Button Style="{StaticResource Tool}" Tag="bottom" Click="AlignClicked" AutomationProperties.Name="{l:T editor.toolbar.align_bottom}"
                                        ToolTip="{l:T editor.toolbar.align_bottom.tip}">
                                    <Path Style="{StaticResource Drawn}" Data="M1,13.3 h14 v1.2 h-14 Z M3,2 h3.5 v9.5 h-3.5 Z M9.5,5.5 h3.5 v6 h-3.5 Z" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{l:T editor.toolbar.align}" Style="{StaticResource GroupName}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Tool}" Tag="across" Click="AlignClicked" AutomationProperties.Name="{l:T editor.toolbar.distribute_across}"
                                        ToolTip="{l:T editor.toolbar.distribute_across.tip}">
                                    <Path Style="{StaticResource Drawn}" Data="M1,1 h1.2 v14 h-1.2 Z M13.8,1 h1.2 v14 h-1.2 Z M5.5,4 h5 v8 h-5 Z" />
                                </Button>
                                <Button Style="{StaticResource Tool}" Tag="down" Click="AlignClicked" AutomationProperties.Name="{l:T editor.toolbar.distribute_down}"
                                        ToolTip="{l:T editor.toolbar.distribute_down.tip}">
                                    <Path Style="{StaticResource Drawn}" Data="M1,1 h14 v1.2 h-14 Z M1,13.8 h14 v1.2 h-14 Z M4,5.5 h8 v5 h-8 Z" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{l:T editor.toolbar.distribute}" Style="{StaticResource GroupName}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="GroupButton" Style="{StaticResource Tool}" Click="GroupClicked" AutomationProperties.Name="{l:T editor.toolbar.group}"
                                        ToolTip="{l:T editor.toolbar.group.tip}">
                                    <Path Style="{StaticResource Drawn}" Data="M1,1 h4 v1.2 h-2.8 v2.8 h-1.2 Z M15,1 v4 h-1.2 v-2.8 h-2.8 v-1.2 Z M1,15 v-4 h1.2 v2.8 h2.8 v1.2 Z M15,15 h-4 v-1.2 h2.8 v-2.8 h1.2 Z M4.5,4.5 h4.5 v4.5 h-4.5 Z M7,7 h4.5 v4.5 h-4.5 Z" />
                                </Button>
                                <Button x:Name="UngroupButton" Style="{StaticResource Tool}" Click="UngroupClicked" AutomationProperties.Name="{l:T editor.toolbar.ungroup}"
                                        ToolTip="{l:T editor.toolbar.ungroup.tip}">
                                    <Path Style="{StaticResource Drawn}" Data="M1.5,1.5 h6 v6 h-6 Z M8.5,8.5 h6 v6 h-6 Z" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{l:T editor.toolbar.groups}" Style="{StaticResource GroupName}" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- The stage: the box drawn as the controller laid it out, and what it shows at its top right. -->
            <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="8" Background="#FF0B0B0C" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <!-- Transparent, not empty, so the whole view takes the pointer past the stage. -->
                    <ScrollViewer x:Name="StageView" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Background="Transparent">
                        <Canvas x:Name="Stage" Background="Transparent" Focusable="True" HorizontalAlignment="Left" VerticalAlignment="Top"
                                MouseLeftButtonDown="StagePressed" MouseMove="StageMoved" MouseLeftButtonUp="StageReleased" />
                    </ScrollViewer>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Padding="10,4,4,4" CornerRadius="6"
                            Background="#E61C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="SizesCheck" Content="{l:T editor.stage.sizes}" Foreground="White" VerticalAlignment="Center"
                                      ToolTip="{l:T editor.stage.sizes.tip}"
                                      Checked="ViewChanged" Unchecked="ViewChanged" />
                            <ComboBox x:Name="ZoomBox" Width="88" Margin="8,0,0,0" DisplayMemberPath="Title" SelectedValuePath="Key"
                                      SelectionChanged="ViewChanged" ToolTip="{l:T editor.stage.zoom.tip}"
                                      AutomationProperties.Name="{l:T editor.stage.zoom}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <!-- The box's style and size; it wraps when the middle is narrow. -->
                <WrapPanel>
                    <TextBlock Text="{l:T editor.box.title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="{l:T editor.box.style}" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            ToolTip="{l:T editor.box.style.tip}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="StyleIcon" Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="StyleShown" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{l:T editor.box.width}" VerticalAlignment="Center" Margin="18,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="BoxWidth" Width="100" TextChanged="BoxEdited" LostKeyboardFocus="FieldLeft"
                             ToolTip="{l:T editor.box.width.tip}"
                             AutomationProperties.Name="{l:T editor.box.width.field}" />
                    <Button x:Name="FitButton" Content="{l:T editor.box.fit}" Margin="6,0,0,0" Click="FitClicked"
                            ToolTip="{l:T editor.box.fit.tip}" />
                    <TextBlock x:Name="WidthShown" VerticalAlignment="Center" />
                    <TextBlock Text="{l:T editor.box.height}" VerticalAlignment="Center" Margin="18,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HeightShown" VerticalAlignment="Center"
                               ToolTip="{l:T editor.box.height.tip}" />
                    <TextBlock Text="DIPs" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <!-- The taskbar box's own background color, as the Boxes page sets it; the stage shows the
                         preset on it. -->
                    <TextBlock Text="{l:T editor.box.background}" VerticalAlignment="Center" Margin="18,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="{l:T editor.box.background.tip}" />
                    <Button x:Name="BoxColorButton" Padding="3" VerticalAlignment="Center"
                            ToolTip="{l:T editor.box.background.tip}"
                            AutomationProperties.Name="{l:T boxes.color.swatch}" Click="BoxColorClicked">
                        <Grid Width="18" Height="18">
                            <Border CornerRadius="3">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#FFFFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,6,6" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FFBFBFBF">
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <RectangleGeometry Rect="0,0,3,3" />
                                                            <RectangleGeometry Rect="3,3,3,3" />
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="BoxSwatch" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                        </Grid>
                    </Button>
                    <Button x:Name="BoxDropperButton" Margin="4,0,0,0" Padding="7,4" VerticalAlignment="Center"
                            AutomationProperties.Name="{l:T boxes.color.eyedropper}"
                            ToolTip="{l:T boxes.color.eyedropper}" Click="BoxDropperClicked">
                        <TextBlock Text="&#xEF3C;" Style="{StaticResource Icon}" FontSize="13" />
                    </Button>
                    <TextBlock Text="{l:T editor.box.opacity}" VerticalAlignment="Center" Margin="12,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Slider x:Name="BoxOpacitySlider" Width="100" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                            VerticalAlignment="Center" AutomationProperties.Name="{l:T editor.box.opacity}"
                            ValueChanged="BoxOpacityChanged" />
                    <TextBlock x:Name="BoxOpacityText" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <Button x:Name="BoxDefaultButton" Margin="8,0,0,0" VerticalAlignment="Center"
                            Content="{l:T boxes.color.default}" Click="BoxDefaultClicked" />
                </WrapPanel>
                <TextBlock x:Name="BoxNote" Style="{StaticResource Note}" Margin="0,8,0,0" />
                <TextBlock x:Name="PreviewNote" Style="{StaticResource Note}" Foreground="#FFFFB45C" Margin="0,4,0,0" />
                <TextBlock x:Name="SaveNote" Style="{StaticResource Note}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- The blocks, their tools, and the one picked. -->
        <Border Grid.Column="4" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="16,16,16,12">
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="AddButton" Style="{StaticResource Tool}" Click="AddClicked"
                                ToolTip="{l:T editor.blocks.add.columns.tip}" AutomationProperties.Name="{l:T editor.blocks.add}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" />
                                <TextBlock Text="{l:T editor.blocks.add}" Margin="6,0,4,0" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemoveButton" Style="{StaticResource Tool}" Click="RemoveBlocks"
                                ToolTip="{l:T editor.blocks.delete.tip}" AutomationProperties.Name="{l:T editor.blocks.delete}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                        </Button>
                        <Button x:Name="UpButton" Style="{StaticResource Tool}" Click="MoveBlockUp" AutomationProperties.Name="{l:T editor.blocks.up}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" />
                        </Button>
                        <Button x:Name="DownButton" Style="{StaticResource Tool}" Click="MoveBlockDown" AutomationProperties.Name="{l:T editor.blocks.down}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{l:T editor.blocks.title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="BlockOrder" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                <Border DockPanel.Dock="Top" Margin="0,8,0,0" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <!-- No scrolling across: a long row ends in an ellipsis. -->
                    <ListBox x:Name="BlockList" Height="210" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                             ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="BlockPicked" AutomationProperties.Name="{l:T editor.blocks.title}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,1">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock x:Name="PickedNote" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                <TextBlock x:Name="BlockTitle" DockPanel.Dock="Top" Text="{l:T editor.block.title}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBlock x:Name="NoBlockNote" DockPanel.Dock="Top" Text="{l:T editor.block.none}" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                    <StackPanel x:Name="BlockPanel" Margin="0,0,6,0">
                        <TextBlock Text="{l:T editor.block.content}" Style="{StaticResource Heading}" Margin="0,4,0,2" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{l:T editor.block.kind}" Style="{StaticResource Label}" />
                            <ComboBox x:Name="KindBox" DisplayMemberPath="Title" SelectedValuePath="Key" SelectionChanged="BlockEdited"
                                      AutomationProperties.Name="{l:T editor.block.kind}" />
                        </DockPanel>
                        <DockPanel x:Name="ServiceRow" Style="{StaticResource Row}">
                            <TextBlock Text="{l:T editor.block.service}" Style="{StaticResource Label}" />
                            <ComboBox x:Name="ServiceBox" DisplayMemberPath="Title" SelectedValuePath="Key" SelectionChanged="BlockEdited"
                                      AutomationProperties.Name="{l:T editor.block.service}" />
                        </DockPanel>
                        <DockPanel x:Name="LimitRow" Style="{StaticResource Row}">
                            <TextBlock Text="{l:T editor.block.limit}" Style="{StaticResource Label}" />
                            <ComboBox x:Name="LimitBox" DisplayMemberPath="Title" SelectedValuePath="Key" SelectionChanged="BlockEdited"
                                      AutomationProperties.Name="{l:T editor.block.limit}" />
                        </DockPanel>
                        <DockPanel x:Name="MoreLimitsRow" Style="{StaticResource Row}">
                            <TextBlock Text="{l:T editor.block.inner_rings}" Style="{StaticResource Label}" />
                            <!-- One above the other, each as wide as the others, so a limit's
                                 name is not cut short in any language. -->
                            <StackPanel>
                                <ComboBox x:Name="Limit2Box" DisplayMemberPath="Title" SelectedValuePath="Key" SelectionChanged="BlockEdited" />
                                <ComboBox x:Name="Limit3Box" Margin="0,6,0,0" DisplayMemberPath="Title" SelectedValuePath="Key" SelectionChanged="BlockEdited" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel x:Name="ShowRow" Style="{StaticResource Row}">
                            <TextBlock Text="{l:T editor.block.shows}" Style="{StaticResource Label}" />
                            <ComboBox x:Name="ShowBox" DisplayMemberPath="Title" SelectedValuePath="Key" SelectionChanged="BlockEdited" />
                        </DockPanel>
                        <DockPanel x:Name="OwnRow" Style="{StaticResource Row}">
                            <TextBlock Text="{l:T editor.block.words}" Style="{StaticResource Label}" />
                            <TextBox x:Name="OwnText" MaxLength="64" TextChanged="BlockEdited" />
                        </DockPanel>
                        <StackPanel x:Name="FontRow">
                            <TextBlock Text="{l:T editor.block.text}" Style="{StaticResource Heading}" />
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="{l:T editor.block.size}" Style="{StaticResource Label}" />
                                <TextBox x:Name="SizeText" ToolTip="{l:T editor.block.size.tip}"
                                         TextChanged="BlockEdited" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="{l:T editor.block.weight}" Style="{StaticResource Label}" />
                                <ComboBox x:Name="WeightBox" DisplayMemberPath="Title" SelectedValuePath="Key" SelectionChanged="BlockEdited" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="{l:T editor.block.align}" Style="{StaticResource Label}" />
                                <ComboBox x:Name="AlignBox" DisplayMemberPath="Title" SelectedValuePath="Key" SelectionChanged="BlockEdited" />
                            </DockPanel>
                        </StackPanel>
                        <TextBlock x:Name="LookHeading" Text="{l:T editor.block.look}" Style="{StaticResource Heading}" />
                        <DockPanel x:Name="WidthRow" Style="{StaticResource Row}">
                            <TextBlock Text="{l:T editor.block.width}" Style="{StaticResource Label}" />
                            <TextBox x:Name="WidthText" ToolTip="{l:T editor.block.usual.tip}"
                                     TextChanged="BlockEdited" />
                        </DockPanel>
                        <DockPanel x:Name="ThicknessRow" Style="{StaticResource Row}">
                            <TextBlock Text="{l:T editor.block.thickness}" Style="{StaticResource Label}" />
                            <TextBox x:Name="ThicknessText" ToolTip="{l:T editor.block.usual.tip}"
                                     TextChanged="BlockEdited" />
                        </DockPanel>
                        <DockPanel x:Name="ColorRow" Style="{StaticResource Row}">
                            <TextBlock Text="{l:T editor.block.color}" Style="{StaticResource Label}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ColorButton" Padding="6,4" Click="ColorClicked" ToolTip="{l:T editor.block.palette.tip}"
                                        AutomationProperties.Name="{l:T editor.block.palette}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ColorSwatch" Width="20" Height="20" CornerRadius="4" BorderThickness="1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="ColorText" Grid.Column="1" MaxLength="7" Margin="6,0,0,0" TextChanged="BlockEdited"
                                         ToolTip="{l:T editor.block.color.tip}" AutomationProperties.Name="{l:T editor.block.color}" />
                                <!-- A color from anywhere on the screen, into the field. -->
                                <Button x:Name="BlockDropperButton" Grid.Column="2" Margin="6,0,0,0" Padding="7,4"
                                        Click="BlockDropperClicked" ToolTip="{l:T boxes.color.eyedropper}"
                                        AutomationProperties.Name="{l:T boxes.color.eyedropper}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEF3C;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DockPanel>
                        <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Margin="0,4,0,0" Padding="12" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <Button x:Name="ServiceColorButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Click="ServiceColorClicked" AutomationProperties.Name="{l:T editor.block.service_color}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                <Path Data="M2,14 L14,2" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.2" />
                                            </Border>
                                            <TextBlock Text="{l:T editor.block.service_color}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{l:T editor.block.colors}" Style="{StaticResource Caption}" Margin="2,10,0,2" />
                                    <UniformGrid x:Name="Palette" Columns="8" />
                                    <TextBlock Text="{l:T editor.block.greys}" Style="{StaticResource Caption}" Margin="2,8,0,2" />
                                    <UniformGrid x:Name="GreyPalette" Columns="8" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <StackPanel x:Name="StackRow">
                            <TextBlock Text="{l:T editor.block.column}" Style="{StaticResource Heading}" />
                            <CheckBox x:Name="StackedCheck" Content="{l:T editor.block.stacked}" Margin="0,4,0,0" Click="BlockEdited" />
                        </StackPanel>
                        <StackPanel x:Name="PlaceRow">
                            <TextBlock Text="{l:T editor.block.place}" Style="{StaticResource Heading}" />
                            <TextBlock Text="{l:T editor.block.place.caption}" Style="{StaticResource Caption}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="X" VerticalAlignment="Center" />
                                <TextBox x:Name="XText" Grid.Column="1" ToolTip="{l:T editor.block.x.tip}" TextChanged="BlockEdited"
                                         LostKeyboardFocus="FieldLeft" AutomationProperties.Name="X" />
                                <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBox x:Name="YText" Grid.Column="3" ToolTip="{l:T editor.block.y.tip}" TextChanged="BlockEdited"
                                         LostKeyboardFocus="FieldLeft" AutomationProperties.Name="Y" />
                                <TextBlock Text="W" Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0" />
                                <TextBox x:Name="WText" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" TextChanged="BlockEdited"
                                         LostKeyboardFocus="FieldLeft" ToolTip="{l:T editor.block.w.tip}"
                                         AutomationProperties.Name="W" />
                                <TextBlock Text="H" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="10,6,0,0" />
                                <TextBox x:Name="HText" Grid.Row="1" Grid.Column="3" Margin="0,6,0,0" TextChanged="BlockEdited"
                                         LostKeyboardFocus="FieldLeft" ToolTip="{l:T editor.block.h.tip}"
                                         AutomationProperties.Name="H" />
                            </Grid>
                            <Button x:Name="OwnSizeButton" Content="{l:T editor.block.own_size}" Margin="0,8,0,0" Click="OwnSizeClicked"
                                    ToolTip="{l:T editor.block.own_size.tip}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- A new preset: its name, its style and what it starts from, over the window. -->
        <Grid x:Name="CreateLayer" Grid.ColumnSpan="5" Visibility="Collapsed" Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <StackPanel Margin="24,20,24,16">
                        <TextBlock Text="{l:T editor.presets.create}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{l:T editor.create.caption}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <TextBlock Text="{l:T editor.create.name}" Margin="0,18,0,6" />
                        <TextBox x:Name="NewName" MaxLength="40" AutomationProperties.Name="{l:T editor.create.name.field}" />
                        <TextBlock Text="{l:T editor.create.style}" Margin="0,18,0,6" />
                        <UniformGrid x:Name="StyleCards" Columns="2" />
                        <TextBlock Text="{l:T editor.create.from}" Margin="0,18,0,6" />
                        <ComboBox x:Name="StartBox" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{l:T editor.create.from.field}">
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="8,8,0,2"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                        <TextBlock x:Name="CreateNote" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                    <Border Padding="24,14" CornerRadius="0,0,8,8" BorderThickness="0,1,0,0"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{l:T editor.create.cancel}" MinWidth="96" Click="CreateCancelled" />
                            <Button x:Name="CreateConfirm" Content="{l:T editor.create.confirm}" MinWidth="96" Margin="8,0,0,0"
                                    Style="{DynamicResource AccentButtonStyle}" Click="CreateConfirmed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
